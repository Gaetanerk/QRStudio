{
  "name": "qr-studio-by-gaetan",
  "version": "2.0.6",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.qrstudio.gaetan",
    "productName": "QR-Studio-By-Gaetan",
    "artifactName": "${productName}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "Gaetanerk",
        "repo": "QRStudio"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "ico.ico"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "ico.icns"
    },
    "nsis": {
      "oneClick": false,
      "createDesktopShortcut": true
    }
  },
  "devDependencies": {
    "electron": "^41.0.4",
    "electron-builder": "^26.8.1"
  },
  "dependencies": {
    "electron-log": "^5.4.3",
    "electron-updater": "^6.8.3"
  }
}
